# Entorno: desarrollo
# Dominio: https://alfared.apolobyte.online
# Rama: develop
# Uso: docker compose --env-file .env.dev up --build

ENV_FILE=.env.dev
APP_ENV=dev
APP_URL=https://alfared.apolobyte.online
NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=wiliam12345
POSTGRES_DB=Alfared
# No uses 5433: ese puerto ya lo ocupa PostgreSQL de Windows (tus usuarios).
POSTGRES_PORT=5434

# App -> PostgreSQL de Windows, base Alfared (andres@empresa.com, etc.)
DB_USER=postgres
DB_PASSWORD=wiliam12345
DB_DATABASE=Alfared
DB_HOST=host.docker.internal
DB_PORT=5433

PUERTO_BACKEND_CONTENEDOR=3000
PUERTO_FRONTEND_HOST=8080
PUERTO_FRONTEND_CONTENEDOR=80
