# Copia este archivo a .env y completa con TUS datos de PostgreSQL.
# Next.js (npm run dev) lee estas variables al arrancar.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=wiliam12345
POSTGRES_DB=Alfared
DB_USER=postgres
DB_PASSWORD=wiliam12345
DB_DATABASE=Alfared
# Desde Docker hacia Postgres de Windows:
DB_HOST=host.docker.internal
DB_PORT=5432

# Docker Compose (si usas contenedores)
POSTGRES_PORT=5433
PUERTO_BACKEND_CONTENEDOR=3000
PUERTO_FRONTEND_HOST=8080
PUERTO_FRONTEND_CONTENEDOR=80
